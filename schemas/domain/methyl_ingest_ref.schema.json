{
  "$defs": {
    "AzureAccountKeyCredentials": {
      "additionalProperties": false,
      "properties": {
        "accountKey": {
          "format": "password",
          "title": "Accountkey",
          "type": "string",
          "writeOnly": true
        },
        "authMode": {
          "const": "account_key",
          "default": "account_key",
          "title": "Authmode",
          "type": "string"
        }
      },
      "required": [
        "accountKey"
      ],
      "title": "AzureAccountKeyCredentials",
      "type": "object"
    },
    "AzureConnectionStringCredentials": {
      "additionalProperties": false,
      "properties": {
        "authMode": {
          "const": "connection_string",
          "default": "connection_string",
          "title": "Authmode",
          "type": "string"
        },
        "connectionString": {
          "format": "password",
          "title": "Connectionstring",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "connectionString"
      ],
      "title": "AzureConnectionStringCredentials",
      "type": "object"
    },
    "AzureDefaultCredentialCredentials": {
      "additionalProperties": false,
      "properties": {
        "authMode": {
          "const": "default_credential",
          "default": "default_credential",
          "title": "Authmode",
          "type": "string"
        }
      },
      "title": "AzureDefaultCredentialCredentials",
      "type": "object"
    },
    "AzureFastqSource": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "title": "Account",
          "type": "string"
        },
        "container": {
          "title": "Container",
          "type": "string"
        },
        "credentials": {
          "discriminator": {
            "mapping": {
              "account_key": "#/$defs/AzureAccountKeyCredentials",
              "azure_key_vault": "#/$defs/AzureKeyVaultCredentials",
              "connection_string": "#/$defs/AzureConnectionStringCredentials",
              "default_credential": "#/$defs/AzureDefaultCredentialCredentials",
              "encrypted_file": "#/$defs/EncryptedFileCredentials"
            },
            "propertyName": "authMode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AzureAccountKeyCredentials"
            },
            {
              "$ref": "#/$defs/AzureConnectionStringCredentials"
            },
            {
              "$ref": "#/$defs/AzureDefaultCredentialCredentials"
            },
            {
              "$ref": "#/$defs/AzureKeyVaultCredentials"
            },
            {
              "$ref": "#/$defs/EncryptedFileCredentials"
            }
          ],
          "title": "Credentials"
        },
        "prefix": {
          "title": "Prefix",
          "type": "string"
        },
        "type": {
          "const": "azure_blob",
          "default": "azure_blob",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "account",
        "container",
        "prefix",
        "credentials"
      ],
      "title": "AzureFastqSource",
      "type": "object"
    },
    "AzureKeyVaultCredentials": {
      "additionalProperties": false,
      "description": "Credential *reference* resolved on the worker via Managed Identity.",
      "properties": {
        "authMode": {
          "const": "azure_key_vault",
          "default": "azure_key_vault",
          "title": "Authmode",
          "type": "string"
        },
        "materializeAs": {
          "anyOf": [
            {
              "enum": [
                "explicit_keys",
                "account_key",
                "connection_string"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional hint for how to interpret a plain-string secret value.",
          "title": "Materializeas"
        },
        "secretName": {
          "description": "Secret name holding JSON or accessKeyId:secret.",
          "title": "Secretname",
          "type": "string"
        },
        "vaultUrl": {
          "description": "Azure Key Vault URL (https://\u2026.vault.azure.net/).",
          "title": "Vaulturl",
          "type": "string"
        }
      },
      "required": [
        "vaultUrl",
        "secretName"
      ],
      "title": "AzureKeyVaultCredentials",
      "type": "object"
    },
    "EncryptedFileCredentials": {
      "additionalProperties": false,
      "description": "Credential *reference* to a Fernet-encrypted local file (bootstrap / air-gapped).",
      "properties": {
        "authMode": {
          "const": "encrypted_file",
          "default": "encrypted_file",
          "title": "Authmode",
          "type": "string"
        },
        "materializeAs": {
          "anyOf": [
            {
              "enum": [
                "explicit_keys",
                "account_key",
                "connection_string"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional hint for how to interpret a plain-string secret value.",
          "title": "Materializeas"
        },
        "path": {
          "description": "Path to encrypted credential file (owner rw only).",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "EncryptedFileCredentials",
      "type": "object"
    },
    "FileFastqSource": {
      "additionalProperties": false,
      "properties": {
        "basePath": {
          "title": "Basepath",
          "type": "string"
        },
        "prefix": {
          "default": "",
          "title": "Prefix",
          "type": "string"
        },
        "type": {
          "const": "file",
          "default": "file",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "basePath"
      ],
      "title": "FileFastqSource",
      "type": "object"
    },
    "S3ExplicitKeysCredentials": {
      "additionalProperties": false,
      "properties": {
        "accessKeyId": {
          "title": "Accesskeyid",
          "type": "string"
        },
        "authMode": {
          "const": "explicit_keys",
          "default": "explicit_keys",
          "title": "Authmode",
          "type": "string"
        },
        "secretAccessKey": {
          "format": "password",
          "title": "Secretaccesskey",
          "type": "string",
          "writeOnly": true
        },
        "sessionToken": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessiontoken",
          "writeOnly": true
        }
      },
      "required": [
        "accessKeyId",
        "secretAccessKey"
      ],
      "title": "S3ExplicitKeysCredentials",
      "type": "object"
    },
    "S3FastqSource": {
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "title": "Bucket",
          "type": "string"
        },
        "credentials": {
          "discriminator": {
            "mapping": {
              "azure_key_vault": "#/$defs/AzureKeyVaultCredentials",
              "encrypted_file": "#/$defs/EncryptedFileCredentials",
              "explicit_keys": "#/$defs/S3ExplicitKeysCredentials",
              "instance_profile": "#/$defs/S3InstanceProfileCredentials"
            },
            "propertyName": "authMode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/S3ExplicitKeysCredentials"
            },
            {
              "$ref": "#/$defs/S3InstanceProfileCredentials"
            },
            {
              "$ref": "#/$defs/AzureKeyVaultCredentials"
            },
            {
              "$ref": "#/$defs/EncryptedFileCredentials"
            }
          ],
          "title": "Credentials"
        },
        "endpointUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpointurl"
        },
        "prefix": {
          "title": "Prefix",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "type": {
          "const": "s3",
          "default": "s3",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "bucket",
        "prefix",
        "credentials"
      ],
      "title": "S3FastqSource",
      "type": "object"
    },
    "S3InstanceProfileCredentials": {
      "additionalProperties": false,
      "properties": {
        "authMode": {
          "const": "instance_profile",
          "default": "instance_profile",
          "title": "Authmode",
          "type": "string"
        }
      },
      "title": "S3InstanceProfileCredentials",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Pre-download sample ingest descriptor (structured source known, files not yet local).",
  "properties": {
    "$type": {
      "const": "MethylIngestRef",
      "default": "MethylIngestRef",
      "title": "$Type",
      "type": "string"
    },
    "fastqSource": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "azure_blob": "#/$defs/AzureFastqSource",
              "file": "#/$defs/FileFastqSource",
              "s3": "#/$defs/S3FastqSource"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FileFastqSource"
            },
            {
              "$ref": "#/$defs/S3FastqSource"
            },
            {
              "$ref": "#/$defs/AzureFastqSource"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fastqsource"
    },
    "fastqUris": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fastquris"
    },
    "fileCount": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filecount"
    },
    "sampleDir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sampledir"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    }
  },
  "required": [
    "sampleId"
  ],
  "title": "MethylIngestRef",
  "type": "object"
}
