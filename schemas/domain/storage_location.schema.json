{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StorageLocation",
  "description": "Shared provider-discriminated storage locations and credentials for sample ingress/archive and reference-asset downloads. Wire format for workers remains typed fastqSource / sampleDestination JSON.",
  "$defs": {
    "S3ExplicitKeysCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authMode": { "const": "explicit_keys", "default": "explicit_keys", "type": "string" },
        "accessKeyId": { "type": "string" },
        "secretAccessKey": { "type": "string", "format": "password", "writeOnly": true },
        "sessionToken": {
          "anyOf": [
            { "type": "string", "format": "password", "writeOnly": true },
            { "type": "null" }
          ],
          "default": null
        }
      },
      "required": ["accessKeyId", "secretAccessKey"]
    },
    "S3InstanceProfileCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authMode": { "const": "instance_profile", "default": "instance_profile", "type": "string" }
      }
    },
    "AzureAccountKeyCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authMode": { "const": "account_key", "default": "account_key", "type": "string" },
        "accountKey": { "type": "string", "format": "password", "writeOnly": true }
      },
      "required": ["accountKey"]
    },
    "AzureConnectionStringCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authMode": { "const": "connection_string", "default": "connection_string", "type": "string" },
        "connectionString": { "type": "string", "format": "password", "writeOnly": true }
      },
      "required": ["connectionString"]
    },
    "AzureSasTokenCredentials": {
      "type": "object",
      "additionalProperties": false,
      "description": "Azure Blob SAS token (query string, with or without leading ?).",
      "properties": {
        "authMode": { "const": "sas_token", "default": "sas_token", "type": "string" },
        "sasToken": { "type": "string", "format": "password", "writeOnly": true }
      },
      "required": ["sasToken"]
    },
    "AzureSasUrlCredentials": {
      "type": "object",
      "additionalProperties": false,
      "description": "Full Azure Blob SAS URL (container or blob).",
      "properties": {
        "authMode": { "const": "sas_url", "default": "sas_url", "type": "string" },
        "sasUrl": { "type": "string", "format": "password", "writeOnly": true }
      },
      "required": ["sasUrl"]
    },
    "AzureDefaultCredentialCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authMode": { "const": "default_credential", "default": "default_credential", "type": "string" }
      }
    },
    "GcsServiceAccountCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authMode": { "const": "service_account_json", "default": "service_account_json", "type": "string" },
        "serviceAccountJson": { "type": "string", "format": "password", "writeOnly": true }
      },
      "required": ["serviceAccountJson"]
    },
    "GcsHmacCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authMode": { "const": "hmac_keys", "default": "hmac_keys", "type": "string" },
        "accessId": { "type": "string" },
        "secret": { "type": "string", "format": "password", "writeOnly": true }
      },
      "required": ["accessId", "secret"]
    },
    "GcsApplicationDefaultCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authMode": { "const": "application_default", "default": "application_default", "type": "string" }
      }
    },
    "HttpsBearerCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authMode": { "const": "bearer", "default": "bearer", "type": "string" },
        "token": { "type": "string", "format": "password", "writeOnly": true }
      },
      "required": ["token"]
    },
    "S3Location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "s3", "default": "s3", "type": "string" },
        "bucket": { "type": "string" },
        "region": { "type": ["string", "null"], "default": null },
        "endpointUrl": { "type": ["string", "null"], "default": null },
        "prefix": { "type": "string" },
        "prefixBase": { "type": ["string", "null"] },
        "credentialName": { "type": "string", "description": "cfg.credential name (registry); expanded at schedule time" },
        "credentials": {
          "oneOf": [
            { "$ref": "#/$defs/S3ExplicitKeysCredentials" },
            { "$ref": "#/$defs/S3InstanceProfileCredentials" }
          ]
        }
      },
      "required": ["bucket"]
    },
    "AzureBlobLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "azure_blob", "default": "azure_blob", "type": "string" },
        "account": { "type": "string" },
        "container": { "type": "string" },
        "prefix": { "type": "string" },
        "credentialName": { "type": "string" },
        "credentials": {
          "oneOf": [
            { "$ref": "#/$defs/AzureAccountKeyCredentials" },
            { "$ref": "#/$defs/AzureConnectionStringCredentials" },
            { "$ref": "#/$defs/AzureSasTokenCredentials" },
            { "$ref": "#/$defs/AzureSasUrlCredentials" },
            { "$ref": "#/$defs/AzureDefaultCredentialCredentials" }
          ]
        }
      },
      "required": ["account", "container"]
    },
    "GcsLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "gcs", "default": "gcs", "type": "string" },
        "bucket": { "type": "string" },
        "prefix": { "type": "string" },
        "projectId": { "type": ["string", "null"], "default": null },
        "credentialName": { "type": "string" },
        "credentials": {
          "oneOf": [
            { "$ref": "#/$defs/GcsServiceAccountCredentials" },
            { "$ref": "#/$defs/GcsHmacCredentials" },
            { "$ref": "#/$defs/GcsApplicationDefaultCredentials" }
          ]
        }
      },
      "required": ["bucket"]
    },
    "FileLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "file", "default": "file", "type": "string" },
        "basePath": { "type": "string" },
        "prefix": { "type": "string", "default": "" }
      },
      "required": ["basePath"]
    },
    "HttpsLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "https", "default": "https", "type": "string" },
        "baseUrl": { "type": "string" },
        "credentialName": { "type": "string" },
        "credentials": {
          "oneOf": [
            { "$ref": "#/$defs/HttpsBearerCredentials" }
          ]
        }
      },
      "required": ["baseUrl"]
    },
    "StorageLocation": {
      "oneOf": [
        { "$ref": "#/$defs/S3Location" },
        { "$ref": "#/$defs/AzureBlobLocation" },
        { "$ref": "#/$defs/GcsLocation" },
        { "$ref": "#/$defs/FileLocation" },
        { "$ref": "#/$defs/HttpsLocation" }
      ]
    },
    "StorageProfileDocument": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fastqStorageEndpoint": {
          "type": "string",
          "description": "cfg.storage_endpoint name for laboratory FASTQ ingress"
        },
        "sampleStorageEndpoint": {
          "type": "string",
          "description": "cfg.storage_endpoint name for sample/H5 archive"
        }
      }
    },
    "ReferenceAssetDocument": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "assetType": {
          "type": "string",
          "description": "e.g. linear_genome, gtf, pangenome_bundle"
        },
        "destRoot": { "type": "string" },
        "recipe": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["op"],
                "properties": {
                  "op": {
                    "type": "string",
                    "enum": ["mkdir", "download", "checksum", "run"]
                  },
                  "uri": { "type": "string" },
                  "storageEndpoint": { "type": "string" },
                  "key": { "type": "string" },
                  "prefix": { "type": "string" },
                  "dest": { "type": "string" },
                  "path": { "type": "string" },
                  "sha256": { "type": "string" },
                  "md5": { "type": "string" },
                  "argv": { "type": "array", "items": { "type": "string" } },
                  "cwd": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/StorageLocation" }
  ]
}
