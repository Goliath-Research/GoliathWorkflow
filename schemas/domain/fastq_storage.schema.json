        "authMode": {
          "const": "account_key",
          "default": "account_key",
          "title": "Authmode",
          "type": "string"
        }
      },
      "required": [
        "accountKey"
      ],
      "title": "AzureAccountKeyCredentials",
      "type": "object"
    },
    "AzureConnectionStringCredentials": {
      "additionalProperties": false,
