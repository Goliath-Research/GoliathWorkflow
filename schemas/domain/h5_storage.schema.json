{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H5Storage",
  "$defs": {
    "AzureAccountKeyCredentials": {
      "$ref": "fastq_storage.schema.json#/$defs/AzureAccountKeyCredentials"
    },
    "AzureConnectionStringCredentials": {
      "$ref": "fastq_storage.schema.json#/$defs/AzureConnectionStringCredentials"
    },
    "AzureDefaultCredentialCredentials": {
      "$ref": "fastq_storage.schema.json#/$defs/AzureDefaultCredentialCredentials"
    },
    "AzureH5Destination": {
      "additionalProperties": false,
      "properties": {
        "account": { "type": "string" },
        "container": { "type": "string" },
        "credentials": {
          "oneOf": [
            { "$ref": "#/$defs/AzureAccountKeyCredentials" },
            { "$ref": "#/$defs/AzureConnectionStringCredentials" },
            { "$ref": "#/$defs/AzureDefaultCredentialCredentials" }
          ]
        },
        "prefix": { "type": "string" },
        "type": { "const": "azure_blob", "default": "azure_blob", "type": "string" }
      },
      "required": ["account", "container", "prefix", "credentials"],
      "type": "object"
    },
    "AzureH5StorageDefaults": {
      "additionalProperties": false,
      "properties": {
        "account": { "type": "string" },
        "container": { "type": "string" },
        "credentials": {
          "oneOf": [
            { "$ref": "#/$defs/AzureAccountKeyCredentials" },
            { "$ref": "#/$defs/AzureConnectionStringCredentials" },
            { "$ref": "#/$defs/AzureDefaultCredentialCredentials" }
          ]
        },
        "type": { "const": "azure_blob", "default": "azure_blob", "type": "string" }
      },
      "required": ["account", "container", "credentials"],
      "type": "object"
    },
    "FileH5Destination": {
      "additionalProperties": false,
      "properties": {
        "basePath": { "type": "string" },
        "prefix": { "default": "", "type": "string" },
        "type": { "const": "file", "default": "file", "type": "string" }
      },
      "required": ["basePath"],
      "type": "object"
    },
    "FileH5StorageDefaults": {
      "additionalProperties": false,
      "properties": {
        "basePath": { "type": "string" },
        "type": { "const": "file", "default": "file", "type": "string" }
      },
      "required": ["basePath"],
      "type": "object"
    },
    "S3ExplicitKeysCredentials": {
      "$ref": "fastq_storage.schema.json#/$defs/S3ExplicitKeysCredentials"
    },
    "S3H5Destination": {
      "additionalProperties": false,
      "properties": {
        "bucket": { "type": "string" },
        "credentials": {
          "oneOf": [
            { "$ref": "#/$defs/S3ExplicitKeysCredentials" },
            { "$ref": "fastq_storage.schema.json#/$defs/S3InstanceProfileCredentials" }
          ]
        },
        "endpointUrl": { "type": ["string", "null"] },
        "prefix": { "type": "string" },
        "region": { "type": ["string", "null"] },
        "type": { "const": "s3", "default": "s3", "type": "string" }
      },
      "required": ["bucket", "prefix", "credentials"],
      "type": "object"
    },
    "S3H5StorageDefaults": {
      "additionalProperties": false,
      "properties": {
        "bucket": { "type": "string" },
        "credentials": {
          "oneOf": [
            { "$ref": "#/$defs/S3ExplicitKeysCredentials" },
            { "$ref": "fastq_storage.schema.json#/$defs/S3InstanceProfileCredentials" }
          ]
        },
        "endpointUrl": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "type": { "const": "s3", "default": "s3", "type": "string" }
      },
      "required": ["bucket", "credentials"],
      "type": "object"
    }
  },
  "H5DestinationLocation": {
    "oneOf": [
      { "$ref": "#/$defs/FileH5Destination" },
      { "$ref": "#/$defs/S3H5Destination" },
      { "$ref": "#/$defs/AzureH5Destination" }
    ]
  },
  "H5StorageDefaults": {
    "oneOf": [
      { "$ref": "#/$defs/FileH5StorageDefaults" },
      { "$ref": "#/$defs/S3H5StorageDefaults" },
      { "$ref": "#/$defs/AzureH5StorageDefaults" }
    ]
  }
}
