{
  "$defs": {
    "EcdfBackendParams": {
      "additionalProperties": false,
      "properties": {
        "covariate_categorical_columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covariate Categorical Columns"
        },
        "covariate_id_column": {
          "default": "sample_id",
          "title": "Covariate Id Column",
          "type": "string"
        },
        "covariate_missing_numeric_strategy": {
          "default": "mean",
          "title": "Covariate Missing Numeric Strategy",
          "type": "string"
        },
        "covariate_numeric_columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covariate Numeric Columns"
        },
        "covariate_ordinal_columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covariate Ordinal Columns"
        },
        "covariate_ordinal_maps": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covariate Ordinal Maps"
        },
        "covariate_ordinal_unknown_value": {
          "default": 0.0,
          "title": "Covariate Ordinal Unknown Value",
          "type": "number"
        },
        "covariate_standardize_numeric": {
          "default": true,
          "title": "Covariate Standardize Numeric",
          "type": "boolean"
        },
        "covariates_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covariates Path"
        },
        "covariates_strict_join": {
          "default": false,
          "title": "Covariates Strict Join",
          "type": "boolean"
        },
        "ecdf_aggregated_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, train/use aggregated observed-hybrid ECDF OvR package. When null, auto-enable for feature_mode=observed_hybrid and feature_family_set!=dmp.",
          "title": "Ecdf Aggregated Enabled"
        },
        "ecdf_aggregated_n_bins": {
          "default": 100,
          "description": "Histogram bin count per feature for aggregated ECDF heads.",
          "maximum": 512,
          "minimum": 8,
          "title": "Ecdf Aggregated N Bins",
          "type": "integer"
        },
        "ecdf_second_stage_enabled": {
          "default": false,
          "title": "Ecdf Second Stage Enabled",
          "type": "boolean"
        },
        "feature_family_set": {
          "default": "dmp",
          "title": "Feature Family Set",
          "type": "string"
        },
        "feature_mode": {
          "default": "raw_dmp",
          "title": "Feature Mode",
          "type": "string"
        },
        "gene_feature_loading": {
          "default": "frozen",
          "description": "For observed_hybrid gene-family features: frozen (use only frozen DMP loci) or range (expand to all loci inside frozen gene-feature ranges).",
          "title": "Gene Feature Loading",
          "type": "string"
        },
        "gene_scored_gene_weight": {
          "default": "importance_x_sqrt_support",
          "description": "Gene-level weighting when pooling to gene_directional_score: importance_x_sqrt_support or importance_only.",
          "title": "Gene Scored Gene Weight",
          "type": "string"
        },
        "gene_scored_min_support_n": {
          "default": 2,
          "description": "Minimum gene_support_n for a gene to enter the gene_scored comparison panel (feature_family_set gene_scored or dmp+gene_scored).",
          "minimum": 1,
          "title": "Gene Scored Min Support N",
          "type": "integer"
        },
        "gene_scored_use_region_weight": {
          "default": true,
          "description": "Multiply per-locus weights by region_weight when building gene_directional_score features.",
          "title": "Gene Scored Use Region Weight",
          "type": "boolean"
        },
        "mapper_gene_columns": {
          "items": {
            "type": "string"
          },
          "title": "Mapper Gene Columns",
          "type": "array"
        },
        "model_bundle_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Bundle Dir"
        },
        "model_weight_column": {
          "default": "effect_size",
          "title": "Model Weight Column",
          "type": "string"
        },
        "observed_feature_dmr_window_bp": {
          "default": 100000,
          "minimum": 1,
          "title": "Observed Feature Dmr Window Bp",
          "type": "integer"
        },
        "observed_feature_include_chromosome": {
          "default": true,
          "title": "Observed Feature Include Chromosome",
          "type": "boolean"
        },
        "observed_feature_include_dmp": {
          "default": true,
          "title": "Observed Feature Include Dmp",
          "type": "boolean"
        },
        "observed_feature_include_dmr": {
          "default": true,
          "title": "Observed Feature Include Dmr",
          "type": "boolean"
        },
        "observed_feature_include_gene": {
          "default": true,
          "title": "Observed Feature Include Gene",
          "type": "boolean"
        },
        "observed_feature_max_dmrs": {
          "default": 32,
          "minimum": 0,
          "title": "Observed Feature Max Dmrs",
          "type": "integer"
        },
        "observed_feature_max_genes": {
          "default": 32,
          "minimum": 0,
          "title": "Observed Feature Max Genes",
          "type": "integer"
        },
        "observed_feature_min_coverage": {
          "default": 1,
          "minimum": 1,
          "title": "Observed Feature Min Coverage",
          "type": "integer"
        },
        "observed_feature_min_obs_fraction": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Observed Feature Min Obs Fraction",
          "type": "number"
        },
        "observed_feature_quality_columns": {
          "description": "Observed-hybrid columns computed and exported but excluded from model training.",
          "items": {
            "type": "string"
          },
          "title": "Observed Feature Quality Columns",
          "type": "array"
        },
        "observed_feature_quantiles": {
          "items": {
            "type": "number"
          },
          "title": "Observed Feature Quantiles",
          "type": "array"
        },
        "observed_hist_alpha": {
          "default": 0.5,
          "minimum": 0.0,
          "title": "Observed Hist Alpha",
          "type": "number"
        },
        "observed_hist_eps": {
          "default": 1e-06,
          "exclusiveMinimum": 0.0,
          "title": "Observed Hist Eps",
          "type": "number"
        },
        "observed_hist_evidence_clip_cap": {
          "default": 5.0,
          "minimum": 0.0,
          "title": "Observed Hist Evidence Clip Cap",
          "type": "number"
        },
        "observed_hist_tail_agreement_threshold": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Observed Hist Tail Agreement Threshold",
          "type": "number"
        },
        "region_directional_min_loci": {
          "default": 1,
          "description": "Minimum panel loci per (comparison, region) required to emit a region_directional_score column.",
          "minimum": 1,
          "title": "Region Directional Min Loci",
          "type": "integer"
        },
        "region_directional_region_types": {
          "description": "Structural region types for region_directional_score__{comparison}__{region} when feature_family_set includes gene_scored.",
          "items": {
            "type": "string"
          },
          "title": "Region Directional Region Types",
          "type": "array"
        },
        "tabular_max_dmps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional cap for loci retained from model bundle. null/0 means keep all stable DMPs.",
          "title": "Tabular Max Dmps"
        }
      },
      "title": "EcdfBackendParams",
      "type": "object"
    },
    "EcdfBackendProfile": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/EcdfBackendParams"
        }
      },
      "title": "EcdfBackendProfile",
      "type": "object"
    },
