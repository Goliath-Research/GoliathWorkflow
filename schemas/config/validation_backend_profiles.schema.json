    "HistGradientBoostingMethodConfig": {
      "properties": {
        "method": {
          "const": "hist_gradient_boosting",
          "title": "Method",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/HistGradientBoostingMethodParams"
        }
      },
      "required": [
        "method"
      ],
      "title": "HistGradientBoostingMethodConfig",
      "type": "object"
    },
    "HistGradientBoostingMethodParams": {
      "properties": {
        "learning_rate": {
          "default": 0.1,
          "exclusiveMinimum": 0.0,
          "title": "Learning Rate",
          "type": "number"
        },
        "max_depth": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Depth"
        },
        "max_iter": {
          "default": 100,
          "minimum": 1,
