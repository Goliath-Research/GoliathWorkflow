{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PipelineProfile",
  "description": "Versioned pipeline parameter pack for DomainProgram workflows.",
  "type": "object",
  "properties": {
    "pipelineProfile": { "type": "string" },
    "pipelineProcedure": {
      "type": "string",
      "description": "Optional assay procedure pack id (profiles/procedures/<id>.procedure.json)."
    },
    "researchMode": {
      "type": "string",
      "description": "samd_research statistical axis overlay (gene_fc, dual_fc, …)."
    },
    "runDmpSelection": { "type": "boolean" },
    "runGeneFeaturecuts": { "type": "boolean" },
    "runBiomarkerFilter": { "type": "boolean" },
    "runGeneFeatureSelect": { "type": "boolean" },
    "runProgressionAnalysis": { "type": "boolean" },
    "stabilityFeaturecutsEnabled": { "type": "boolean" },
    "stabilityGeneFeaturecutsEnabled": { "type": "boolean" },
    "stabilityGeneBiomarkerFilterEnabled": { "type": "boolean" },
    "actionConfig": {
      "type": "object",
      "description": "Per-action parameter overrides (detection, mapper, validation, …)",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
