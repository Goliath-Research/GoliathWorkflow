{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SiteManifest",
  "description": "Site-wide infrastructure defaults for MethylPipeline (genomes, caches, cluster settings). Not study-specific.",
  "type": "object",
  "properties": {
    "reference_genome": {
      "type": "object",
      "properties": {
        "fasta": { "type": "string" }
      },
      "additionalProperties": true
    },
    "annotation": {
      "type": "object",
      "properties": {
        "gtf": { "type": "string" }
      },
      "additionalProperties": true
    },
    "methyl_mapper_home": { "type": "string" },
    "caches": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "parabricks": {
      "type": "object",
      "additionalProperties": true
    },
    "methyl_extract": {
      "type": "object",
      "additionalProperties": true
    },
    "pangenome_genome": {
      "type": "object",
      "description": "HPRC / vg Giraffe pangenome graph bundle (surjected to linear_ref_fasta coordinates). Operator must supply a bisulfite-compatible graph for WGBS.",
      "properties": {
        "gbz": { "type": "string", "description": "Path to .gbz graph index" },
        "dist": { "type": "string", "description": "Path to Giraffe distance index (.dist)" },
        "min": { "type": "string", "description": "Path to Giraffe minimizer index (.min)" },
        "zipcodes": { "type": "string", "description": "Path to Giraffe zipcodes index" },
        "ref_paths": { "type": "string", "description": "Path to GRCh38 ref-paths file for surjection" },
        "linear_ref_fasta": {
          "type": "string",
          "description": "Linear GRCh38 FASTA matching ref_paths (used by collectmultiplemetrics and MethylExtractor)"
        }
      },
      "additionalProperties": true
    },
    "actionConfig": {
      "type": "object",
      "description": "Optional per-action defaults keyed by catalog action_config_key",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
