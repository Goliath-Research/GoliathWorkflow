{
  "$defs": {
    "MethylGrapherGraphIndexFiles": {
      "additionalProperties": false,
      "description": "One converted-graph Giraffe index set (C2T or G2A).",
      "properties": {
        "dist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to Giraffe .dist index",
          "title": "Dist"
        },
        "gbz": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to .gbz graph index",
          "title": "Gbz"
        },
        "min": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to Giraffe minimizer (.min / .withzip.min)",
          "title": "Min"
        },
        "zipcodes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to Giraffe zipcodes index",
          "title": "Zipcodes"
        }
      },
      "title": "MethylGrapherGraphIndexFiles",
      "type": "object"
    },
    "MethylGrapherReadLevelConfig": {
      "additionalProperties": false,
      "description": "Read-level pattern extraction knobs under actionConfig.methylgrapher_wgbs.read_level.",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enable read-level / pattern extraction. Operator-set per site/profile.",
          "title": "Enabled"
        },
        "tile_size": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pattern tile size (bp). Operator-set per site/profile.",
          "title": "Tile Size"
        }
      },
      "title": "MethylGrapherReadLevelConfig",
      "type": "object"
    },
    "MethylGrapherWgbsStepConfig": {
      "additionalProperties": false,
      "description": "Operator-tunable methylGrapher WGBS pangenome knobs (actionConfig.methylgrapher_wgbs).\n\nAsset paths are site-pinned under ``/work/genomes/pangenome/.../d9-bs/...`` and\nbaked into task ``resolvedConfig`` at instance configuration. Workers must not\nre-read site/profile manifests for these values when ``resolvedConfig`` is present.",
      "properties": {
        "alignment_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Must be pangenome_wgbs when this section is used. Set at site/profile/procedure.",
          "title": "Alignment Mode"
        },
        "c2t": {
          "anyOf": [
            {
              "$ref": "#/$defs/MethylGrapherGraphIndexFiles"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "C-to-T converted graph Giraffe indexes."
        },
        "cg_only": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MethylCall -cg_only. Operator-set per site/profile.",
          "title": "Cg Only"
        },
        "contexts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Methylation contexts to emit as {chrom}-{ctx}.h5 (e.g. CG).",
          "title": "Contexts"
        },
        "cpg_tsv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "methylGrapher {prefix}cpg.tsv (graph CpG registry).",
          "title": "Cpg Tsv"
        },
        "directional": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Directional WGBS library (methylGrapher -directional). Operator-set per site/profile.",
          "title": "Directional"
        },
        "g2a": {
          "anyOf": [
            {
              "$ref": "#/$defs/MethylGrapherGraphIndexFiles"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "G-to-A converted graph Giraffe indexes."
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pinned methylGrapher(+vg) Docker image ref/digest. Or METHYL_METHYLGRAPHER_IMAGE.",
          "title": "Image"
        },
        "image_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional immutable digest recorded in CAAS fingerprints / provenance.",
          "title": "Image Digest"
        },
        "index_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PrepareGenome-style index prefix under the BS bundle (e.g. .../hprc-d9-bs).",
          "title": "Index Prefix"
        },
        "linear_ref_fasta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linear GRCh38 FASTA matching ref_paths (QC BAM / extraction contracts).",
          "title": "Linear Ref Fasta"
        },
        "methylgrapher_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pinned methylGrapher version string for provenance / CAAS.",
          "title": "Methylgrapher Version"
        },
        "node_replacement_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional node-replacement JSON from PrepareGenome.",
          "title": "Node Replacement Json"
        },
        "original_gbz": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unconverted graph GBZ used for MethylCall / coordinate provenance.",
          "title": "Original Gbz"
        },
        "read_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/MethylGrapherReadLevelConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Read-level pattern extraction knobs. Operator-set per site/profile."
        },
        "ref_paths": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GRCh38 ref-paths file for surjection / linear coordinates.",
          "title": "Ref Paths"
        },
        "threads": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Worker threads for methylGrapher/vg. Operator-set per site/profile.",
          "title": "Threads"
        },
        "vg_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pinned vg version string for provenance / CAAS (must match index builder).",
          "title": "Vg Version"
        }
      },
      "title": "MethylGrapherWgbsStepConfig",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "executionScopeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executionscopeid"
    },
    "forceRealign": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Forcerealign"
    },
    "project": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Legacy alias of projectPath from older input templates (provenance only).",
      "title": "Project"
    },
    "projectPath": {
      "title": "Projectpath",
      "type": "string"
    },
    "resolvedConfig": {
      "anyOf": [
        {
          "$ref": "#/$defs/MethylGrapherWgbsStepConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Merged actionConfig.methylgrapher_wgbs (+ extract overlays)."
    },
    "sampleDir": {
      "title": "Sampledir",
      "type": "string"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "tool": {
      "default": "MethylGrapherWgbsExtract",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "sampleId",
    "sampleDir",
    "projectPath"
  ],
  "title": "MethylGrapherWgbsExtractTaskInput",
  "type": "object"
}
