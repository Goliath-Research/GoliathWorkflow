{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "guardrails": {
      "additionalProperties": true,
      "title": "Guardrails",
      "type": "object"
    },
    "qcHistory": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Qchistory",
      "type": "array"
    },
    "qcPath": {
      "title": "Qcpath",
      "type": "string"
    },
    "remediateAlignment": {
      "default": false,
      "title": "Remediatealignment",
      "type": "boolean"
    },
    "remediateR2Trim": {
      "default": false,
      "title": "Remediater2Trim",
      "type": "boolean"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "screening": {
      "additionalProperties": true,
      "title": "Screening",
      "type": "object"
    }
  },
  "required": [
    "sampleId",
    "qcPath"
  ],
  "title": "MethylQcTaskOutput",
  "type": "object"
}
