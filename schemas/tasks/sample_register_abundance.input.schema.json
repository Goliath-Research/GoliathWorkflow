{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "projectPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projectpath"
    },
    "sampleDir": {
      "title": "Sampledir",
      "type": "string"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "source": {
      "default": "diann",
      "title": "Source",
      "type": "string"
    },
    "tool": {
      "default": "ProteomicsRegisterAbundance",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "sampleId",
    "sampleDir"
  ],
  "title": "RegisterAbundanceTaskInput",
  "type": "object"
}
