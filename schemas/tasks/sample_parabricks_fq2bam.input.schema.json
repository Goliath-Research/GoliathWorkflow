{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Input for sample.parabricks_fq2bam (Parabricks fq2bam_meth via Docker).",
  "properties": {
    "bwaThreads": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bwathreads"
    },
    "parabricksImage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parabricksimage"
    },
    "referenceFasta": {
      "title": "Referencefasta",
      "type": "string"
    },
    "referenceGtf": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Referencegtf"
    },
    "sampleDir": {
      "title": "Sampledir",
      "type": "string"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "tool": {
      "default": "ParabricksFq2Bam",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "sampleId",
    "sampleDir",
    "referenceFasta"
  ],
  "title": "ParabricksFq2bamTaskInput",
  "type": "object"
}
