{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Input for sample.download_fastq (SampleDownloadFastq).",
  "properties": {
    "fastqSourceUri": {
      "title": "Fastqsourceuri",
      "type": "string"
    },
    "fastqUri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fastquri"
    },
    "sampleDir": {
      "title": "Sampledir",
      "type": "string"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "tool": {
      "default": "SampleDownloadFastq",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "sampleId",
    "sampleDir",
    "fastqSourceUri"
  ],
  "title": "DownloadFastqTaskInput",
  "type": "object"
}
