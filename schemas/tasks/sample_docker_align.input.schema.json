{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alignmentPass": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alignmentpass"
    },
    "forceRealign": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Forcerealign"
    },
    "projectPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projectpath"
    },
    "remediationReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remediationreason"
    },
    "resolvedConfig": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Merged docker_align actionConfig (image, argv, gpu_flags).",
      "title": "Resolvedconfig"
    },
    "sampleDir": {
      "title": "Sampledir",
      "type": "string"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "tool": {
      "default": "SampleDockerAlign",
      "title": "Tool",
      "type": "string"
    },
    "workflowNodeKey": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflownodekey"
    }
  },
  "required": [
    "sampleId",
    "sampleDir"
  ],
  "title": "DockerAlignTaskInput",
  "type": "object"
}
