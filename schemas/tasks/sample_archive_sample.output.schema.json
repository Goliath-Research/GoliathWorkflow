{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "archiveManifestPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archivemanifestpath"
    },
    "archiveMode": {
      "default": "full",
      "title": "Archivemode",
      "type": "string"
    },
    "rejectReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejectreason"
    },
    "remotePrefix": {
      "default": "",
      "title": "Remoteprefix",
      "type": "string"
    },
    "sampleArchived": {
      "default": false,
      "title": "Samplearchived",
      "type": "boolean"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "skippedCount": {
      "default": 0,
      "title": "Skippedcount",
      "type": "integer"
    },
    "skippedFiles": {
      "items": {
        "type": "string"
      },
      "title": "Skippedfiles",
      "type": "array"
    },
    "uploadedCount": {
      "default": 0,
      "title": "Uploadedcount",
      "type": "integer"
    },
    "uploadedFiles": {
      "items": {
        "type": "string"
      },
      "title": "Uploadedfiles",
      "type": "array"
    }
  },
  "required": [
    "sampleId"
  ],
  "title": "ArchiveSampleTaskOutput",
  "type": "object"
}
