{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Input for sample.methyl_extract (MethylExtractor \u2192 {chr}-{ctx}.h5 per chromosome).",
  "properties": {
    "project": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project"
    },
    "projectPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projectpath"
    },
    "referenceFasta": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Referencefasta"
    },
    "sampleDir": {
      "title": "Sampledir",
      "type": "string"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "tool": {
      "default": "MethylExtract",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "sampleId",
    "sampleDir"
  ],
  "title": "MethylExtractTaskInput",
  "type": "object"
}
