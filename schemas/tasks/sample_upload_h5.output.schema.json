{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "remotePrefix": {
      "default": "",
      "title": "Remoteprefix",
      "type": "string"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "skippedCount": {
      "default": 0,
      "title": "Skippedcount",
      "type": "integer"
    },
    "skippedFiles": {
      "items": {
        "type": "string"
      },
      "title": "Skippedfiles",
      "type": "array"
    },
    "uploadedCount": {
      "default": 0,
      "title": "Uploadedcount",
      "type": "integer"
    },
    "uploadedFiles": {
      "items": {
        "type": "string"
      },
      "title": "Uploadedfiles",
      "type": "array"
    }
  },
  "required": [
    "sampleId"
  ],
  "title": "UploadH5TaskOutput",
  "type": "object"
}
