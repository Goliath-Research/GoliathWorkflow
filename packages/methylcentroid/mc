#!/bin/bash
# MethylCentroid Container Wrapper
# Usage: ./mc [args...]

if ! docker ps --format 'table {{.Names}}' | grep -q "^epimethyl$"; then
    echo "❌ Error: epimethyl container is not running."
    echo "Start it with: docker run -d --name epimethyl <your-image>"
    exit 1
fi

# Execute the command inside the container with host user permissions
# Set CUPY_CACHE_DIR to /tmp which is writable by all users in the container
# This is needed because the user mapping doesn't have write access to /home/ubuntu/.cupy
exec docker exec -u $(id -u):$(id -g) \
  -e CUPY_CACHE_DIR=/tmp/.cupy_cache_$(id -u) \
  -w /home/ubuntu/MethylCentroid \
  epimethyl python -m methylcentroid.cli "$@"
