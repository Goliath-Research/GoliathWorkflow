#!/bin/bash
# MethylCentroid Container Wrapper
# Usage: ./mc [args...]

if ! docker ps --format 'table {{.Names}}' | grep -q "^methylpipeline$"; then
    echo "❌ Error: methylpipeline container is not running."
    echo "Start it with: cd /home/ubuntu/MethylPipeline/docker && docker compose up -d"
    exit 1
fi

# Execute the command inside the container
# Working directory is /workspace which maps to /home/ubuntu/MethylPipeline
# Use cli.py for batch configs (--batch-config flag), centroid_cli.py for single processing (--config flag)
exec docker exec -w /workspace methylpipeline \
  python3 -m methyl_centroid.cli "$@"
