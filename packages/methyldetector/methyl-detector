#!/usr/bin/env python3
"""
Standalone CLI script for MethylDetector.
This can be run directly: ./methyl-detector config.json
"""

import sys
import os
import subprocess

def main():
    """Run methyl-detector using Poetry."""
    project_root = os.path.dirname(os.path.abspath(__file__))
    os.chdir(project_root)
    
    try:
        # Run using Poetry
        subprocess.run(["poetry", "run", "python", "-m", "methyl_detector"] + sys.argv[1:], check=True)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
    except FileNotFoundError:
        print("Error: Poetry not found. Please install Poetry or use 'poetry run methyl-detector'")
        sys.exit(1)

if __name__ == "__main__":
    main() 