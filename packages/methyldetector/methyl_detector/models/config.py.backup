"""Configuration models for MethylDetector."""

from pathlib import Path
from typing import Union, Optional, List, Literal
from pydantic import BaseModel, Field, field_validator, model_validator


class MethylDetectorConfig(BaseModel):
    """Unified configuration for MethylDetector analysis (single or multiple comparisons)."""

    # Mode selection
    mode: Literal["single", "multiple"] = Field(..., description="Analysis mode: 'single' for two centroids, 'multiple' for chromosome-context combinations")

    # Single comparison mode fields
    centroid1_path: Optional[Union[str, Path]] = Field(default=None, description="Path to first extended centroid .h5 file (single mode)")
    centroid2_path: Optional[Union[str, Path]] = Field(default=None, description="Path to second extended centroid .h5 file (single mode)")

    # Multiple comparison mode fields
    centroid1_dir: Optional[Union[str, Path]] = Field(default=None, description="Directory containing first centroid files (multiple mode)")
    centroid2_dir: Optional[Union[str, Path]] = Field(default=None, description="Directory containing second centroid files (multiple mode)")
    chromosomes: List[str] = Field(default=['1', '2', '3', '4', '5'], description="List of chromosomes to process (multiple mode)")
    contexts: List[str] = Field(default=['CG', 'CHG', 'CHH'], description="List of contexts to process (multiple mode)")

    # Common parameters
    output_dir: Optional[Union[str, Path]] = Field(default=None, description="Output directory for results")
    alpha: float = Field(default=0.05, ge=0.0, le=1.0, description="Significance level for statistical tests")
    random_state: Optional[int] = Field(default=42, description="Random seed for reproducible results")
    min_N: int = Field(default=10, ge=1, description="Minimum sample size for reliable p-value calculation")

    # FDR analysis parameters
    apply_fdr_correction: bool = Field(default=True, description="Apply FDR correction to p-values")
    fdr_method: str = Field(default="storey", description="FDR correction method")
    global_significance_threshold: float = Field(default=0.05, description="Threshold for global significance test")

    # GPU settings
    use_gpu: bool = Field(default=True, description="Whether to use GPU acceleration")

    # DMP filtering parameters for enhanced discrimination
    apply_dmp_filtering: bool = Field(default=True, description="Apply advanced DMP filtering for higher discrimination")
    dmp_filter_method: str = Field(default="combined", description="DMP filtering method")
    min_overlap: float = Field(default=0.6, ge=0.0, le=1.0, description="Maximum distribution overlap for DMP selection")
    min_delta_mean: float = Field(default=0.2, ge=0.0, le=1.0, description="Minimum delta mean for DMP selection")
    min_jeffreys_divergence: float = Field(default=0.5, ge=0.0, description="Minimum Jeffreys divergence for DMP selection")
    min_cohen_d: float = Field(default=0.8, ge=0.0, description="Minimum Cohen's d for DMP selection")
    min_auc: float = Field(default=0.7, ge=0.0, le=1.0, description="Minimum AUC score for DMP selection")
    max_selected_dmps: Optional[int] = Field(default=None, ge=1, description="Maximum number of DMPs to select")
    
    # Minimum subset selection parameters
    target_auc: float = Field(default=0.95, ge=0.0, le=1.0, description="Target AUC threshold for minimum subset selection")
    use_gpu_selection: bool = Field(default=True, description="Use GPU acceleration for minimum subset selection")
    selection_metric: str = Field(default="auc", description="Selection metric: 'auc' or 'youden'")
    target_youden: float = Field(default=0.9, ge=0.0, le=1.0, description="Target Youden's J threshold for minimum subset selection")
    selection_algorithm: str = Field(default="auto", description="DMP selection algorithm: 'auto', 'greedy', 'fast_greedy_plus', 'hierarchical', 'divide_conquer'")
    time_budget_seconds: int = Field(default=300, ge=10, description="Time budget for DMP selection optimization (seconds)")

    @model_validator(mode='after')
    def validate_mode_fields(self):
        """Validate that the correct fields are provided for the selected mode."""
        if self.mode == "single":
            if not self.centroid1_path or not self.centroid2_path:
                raise ValueError("Single mode requires centroid1_path and centroid2_path")
            if self.centroid1_dir or self.centroid2_dir:
                raise ValueError("Single mode should not have centroid directories")
        elif self.mode == "multiple":
            if not self.centroid1_dir or not self.centroid2_dir:
                raise ValueError("Multiple mode requires centroid1_dir and centroid2_dir")
            if self.centroid1_path or self.centroid2_path:
                raise ValueError("Multiple mode should not have centroid paths")
        return self

    @field_validator('centroid1_path', 'centroid2_path')
    @classmethod
    def validate_centroid_paths(cls, v):
        if v is None:
            return v
        path = Path(v)
        if not path.exists():
            raise ValueError(f"Centroid file does not exist: {path}")
        if path.suffix != '.h5':
            raise ValueError(f"Centroid file must be .h5 format: {path}")
        return path

    @field_validator('centroid1_dir', 'centroid2_dir')
    @classmethod
    def validate_centroid_dirs(cls, v):
        if v is None:
            return v
        path = Path(v)
        if not path.exists():
            raise ValueError(f"Centroid directory does not exist: {path}")
        if not path.is_dir():
            raise ValueError(f"Path is not a directory: {path}")
        return path

    @field_validator('output_dir')
    @classmethod
    def validate_output_dir(cls, v):
        if v is not None:
            path = Path(v)
            # Create directory if it doesn't exist
            path.mkdir(parents=True, exist_ok=True)
            return path
        return v

    @field_validator('fdr_method')
    @classmethod
    def validate_fdr_method(cls, v):
        valid_methods = ['storey', 'benjamini_hochberg']
        if v not in valid_methods:
            raise ValueError(f"FDR method must be one of: {valid_methods}")
        return v
    
    @field_validator('selection_metric')
    @classmethod
    def validate_selection_metric(cls, v):
        valid_metrics = ['auc', 'youden']
        if v not in valid_metrics:
            raise ValueError(f"Selection metric must be one of: {valid_metrics}")
        return v

    @field_validator('selection_algorithm')
    @classmethod
    def validate_selection_algorithm(cls, v):
        valid_algorithms = ['auto', 'greedy', 'fast_greedy_plus', 'hierarchical', 'divide_conquer']
        if v not in valid_algorithms:
            raise ValueError(f"Selection algorithm must be one of: {valid_algorithms}")
        return v 