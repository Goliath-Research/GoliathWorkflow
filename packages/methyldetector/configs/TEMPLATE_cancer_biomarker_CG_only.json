{
  "_comment": "Template for cancer biomarker discovery using CG context only",
  "_description": "This config focuses on CG methylation for maximum signal strength in cancer vs healthy comparison",
  
  "chromosome": "1",
  "contexts": ["CG"],
  
  "centroid1_dir": "/path/to/healthy/centroids",
  "centroid2_dir": "/path/to/cancer/centroids",
  "output_dir": "/path/to/output",
  
  "alpha": 0.01,
  "min_delta_mean": 0.2,
  "max_bc": 0.5,
  
  "export_all_biological_dmps": false,
  "target_balanced_accuracy": 0.99,
  "min_dmps_for_export": 5000,
  
  "gamma": 1.5,
  "temperature": 2.5,
  "enable_platt_calibration": true,
  
  "use_gpu": true,
  "random_state": 42,
  
  "validation_mode": "real",
  "validation_split_ratio": 0.0,
  "optimize_for_validation_accuracy": true,
  
  "centroid1_validation_samples": [
    "/path/to/healthy/sample1",
    "/path/to/healthy/sample2"
  ],
  "centroid2_validation_samples": [
    "/path/to/cancer/sample1",
    "/path/to/cancer/sample2"
  ]
}

