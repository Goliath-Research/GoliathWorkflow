<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{F41A7249-2A9C-4B6A-B98A-BC78E76956BF}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="methyl-config-editor\MethylConfigEditor.dproj">
