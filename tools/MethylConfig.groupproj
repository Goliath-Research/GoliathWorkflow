        </Projects>
        <Projects Include="methyl-config-editor\tests\MethylConfigEditorTests.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="methyl-config-editor\MethylConfigEditorWeb.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="MethylConfigEditor">
        <MSBuild Projects="methyl-config-editor\MethylConfigEditor.dproj"/>
    </Target>
    <Target Name="MethylConfigEditor:Clean">
        <MSBuild Projects="methyl-config-editor\MethylConfigEditor.dproj" Targets="Clean"/>
    </Target>
    <Target Name="MethylConfigEditor:Make">
        <MSBuild Projects="methyl-config-editor\MethylConfigEditor.dproj" Targets="Make"/>
