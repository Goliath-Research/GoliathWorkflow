<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{F0CEA938-87AB-4D89-B063-5AB228D56509}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="WfEnginePkg.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="WfEngineSrv.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="WfEngineTests.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="WfEnginePkg">
        <MSBuild Projects="WfEnginePkg.dproj" Properties="Platform=Win64"/>
    </Target>
    <Target Name="WfEnginePkg:Clean">
        <MSBuild Projects="WfEnginePkg.dproj" Targets="Clean" Properties="Platform=Win64"/>
    </Target>
    <Target Name="WfEnginePkg:Make">
        <MSBuild Projects="WfEnginePkg.dproj" Targets="Make" Properties="Platform=Win64"/>
    </Target>
    <Target Name="WfEngineSrv">
        <MSBuild Projects="WfEngineSrv.dproj" Properties="Platform=Win64"/>
    </Target>
    <Target Name="WfEngineSrv:Clean">
        <MSBuild Projects="WfEngineSrv.dproj" Targets="Clean" Properties="Platform=Win64"/>
    </Target>
    <Target Name="WfEngineSrv:Make">
        <MSBuild Projects="WfEngineSrv.dproj" Targets="Make" Properties="Platform=Win64"/>
    </Target>
    <Target Name="WfEngineTests">
        <MSBuild Projects="WfEngineTests.dproj" Properties="Platform=Win64"/>
    </Target>
    <Target Name="WfEngineTests:Clean">
        <MSBuild Projects="WfEngineTests.dproj" Targets="Clean" Properties="Platform=Win64"/>
    </Target>
    <Target Name="WfEngineTests:Make">
        <MSBuild Projects="WfEngineTests.dproj" Targets="Make" Properties="Platform=Win64"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="WfEnginePkg;WfEngineSrv;WfEngineTests"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="WfEnginePkg:Clean;WfEngineSrv:Clean;WfEngineTests:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="WfEnginePkg:Make;WfEngineSrv:Make;WfEngineTests:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
