<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{AB5C4D3E-6F70-8192-A3B4-C5D6E7F80A91}</ProjectGuid>
        <MainSource>WfEngineTests.dpr</MainSource>
        <ProjectVersion>20.2</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <TargetedPlatforms>2</TargetedPlatforms>
        <AppType>Console</AppType>
        <DCC_DcuOutput>..\$(Platform)\$(Config)\tests</DCC_DcuOutput>
        <DCC_ExeOutput>..\bin\$(Platform)\$(Config)\tests</DCC_ExeOutput>
        <DCC_UnitSearchPath>..\src;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Namespace>System;Xml;Data;$(DCC_Namespace)</DCC_Namespace>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Platform)'=='Win64'">
        <Base_Win64>true</Base_Win64>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="WfEngineTests.dpr"/>
        <DCCReference Include="WfEngine.Integration.Tests.pas"/>
    </ItemGroup>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="..\WfEngine.paths.cfg" Condition="Exists('..\WfEngine.paths.cfg')"/>
</Project>
