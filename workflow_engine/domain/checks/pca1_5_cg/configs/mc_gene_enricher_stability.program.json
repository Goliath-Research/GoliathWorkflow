{
  "programVersion": 2,
  "name": "MC_Gene_Enricher_Stability",
  "description": "Monte Carlo stability: discovery detector, mapper, enricher per comparison; gene stability from enricher outputs (no DMP/gene FeatureCuts).",
  "projectPath": "/work/projects/prostate-cancer/configs/project_Healthy_vs_PCa1-5-CG.json",
  "body": [
    {
      "do": "validation.plan_iterations",
      "node_key": "plan_iterations"
    },
    {
      "for": {
        "in": { "ref": "iterations" },
        "as": "iteration",
        "parallel": false
      },
      "do": [
        {
          "for": {
            "in": { "ref": "iteration.centroidGroups" },
            "as": "group",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": { "ref": "project.chromosomes" },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.centroid",
                  "with": {
                    "group": { "ref": "group.label" },
                    "chromosome": { "ref": "chromosome" },
                    "context": { "ref": "context" },
                    "outputDir": { "ref": "group.centroidDir" },
                    "addSamples": { "ref": "group.addSamples" },
                    "removeSamples": { "ref": "group.removeSamples" }
                  },
                  "node_key": "centroid"
                }
              ]
            }
          ]
        },
        {
          "for": {
            "in": { "ref": "project.comparisons" },
            "as": "comparison",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": { "ref": "project.chromosomes" },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.detector",
                  "with": {
                    "chromosome": { "ref": "chromosome" },
                    "context": { "ref": "context" },
                    "comparison": { "ref": "comparison.label" },
                    "stepOverride": {
                      "detection_mode": "discovery_only",
                      "export_classifier": false
                    }
                  },
                  "node_key": "detect"
                }
              ]
            },
            {
              "do": "pipeline.mapper",
              "with": {
                "comparison": { "ref": "comparison.label" },
                "group": { "ref": "comparison.label" }
              },
              "node_key": "mapper"
            },
            {
              "do": "pipeline.enricher",
              "with": {
                "comparison": { "ref": "comparison.label" },
                "group": { "ref": "comparison.label" }
              },
              "node_key": "enricher"
            }
          ]
        }
      ]
    },
    {
      "do": "validation.stability",
      "node_key": "stability"
    },
    {
      "do": "validation.stability_freeze_readiness",
      "node_key": "readiness"
    }
  ]
}
