{
  "programVersion": 2,
  "name": "StudyValidationLifecycle",
  "description": "Full study validation: MC stability, freeze, biological outputs, model MC, selection, hold-out.",
  "projectPath": "/work/prostate-cancer/configs/project_Healthy_vs_PCa1-5-CG.json",
  "body": [
    {
      "do": "validation.plan_iterations",
      "node_key": "plan_iterations"
    },
    {
      "for": {
        "in": { "ref": "iterations" },
        "as": "iteration",
        "parallel": false
      },
      "do": [
        {
          "for": {
            "in": { "ref": "iteration.centroidGroups" },
            "as": "group",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": { "ref": "project.chromosomes" },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.centroid",
                  "with": {
                    "group": { "ref": "group.label" },
                    "chromosome": { "ref": "chromosome" },
                    "context": { "ref": "context" },
                    "outputDir": { "ref": "group.centroidDir" },
                    "addSamples": { "ref": "group.addSamples" },
                    "removeSamples": { "ref": "group.removeSamples" }
                  },
                  "node_key": "centroid"
                }
              ]
            }
          ]
        },
        {
          "for": {
            "in": { "ref": "project.comparisons" },
            "as": "comparison",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": { "ref": "project.chromosomes" },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.detector",
                  "with": {
                    "chromosome": { "ref": "chromosome" },
                    "context": { "ref": "context" },
                    "comparison": { "ref": "comparison.label" }
                  },
                  "node_key": "detect"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "do": "validation.stability",
      "node_key": "stability"
    },
    {
      "do": "validation.stability_freeze_readiness",
      "node_key": "readiness"
    },
    {
      "do": "validation.prepare_freeze_project",
      "node_key": "prepare_freeze"
    },
    {
      "for": {
        "in": { "ref": "groups" },
        "as": "group",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": { "ref": "project.chromosomes" },
            "as": "chromosome",
            "parallel": true
          },
          "do": [
            {
              "do": "pipeline.centroid",
              "with": {
                "group": { "ref": "group.label" },
                "chromosome": { "ref": "chromosome" },
                "context": { "ref": "context" }
              },
              "node_key": "freeze_centroid"
            }
          ]
        }
      ]
    },
    {
      "for": {
        "in": { "ref": "project.comparisons" },
        "as": "comparison",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": { "ref": "project.chromosomes" },
            "as": "chromosome",
            "parallel": true
          },
          "do": [
            {
              "do": "pipeline.detector",
              "with": {
                "chromosome": { "ref": "chromosome" },
                "context": { "ref": "context" },
                "comparison": { "ref": "comparison.label" },
                "fixedDmpPanel": "${var.fixedDmpPanel}"
              },
              "node_key": "freeze_detect"
            }
          ]
        }
      ]
    },
    {
      "do": "pipeline.mapper",
      "node_key": "mapper"
    },
    {
      "do": "pipeline.enricher",
      "node_key": "enricher"
    },
    {
      "do": "pipeline.progression",
      "node_key": "progression"
    },
    {
      "do": "validation.model_mc",
      "node_key": "model_mc"
    },
    {
      "do": "validation.select_best_model",
      "node_key": "select_best_model"
    },
    {
      "do": "validation.post_model_validation",
      "node_key": "post_model_validation"
    }
  ]
}
