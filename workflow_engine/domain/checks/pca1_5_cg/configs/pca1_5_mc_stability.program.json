{
  "programVersion": 2,
  "name": "PCa1_5_MC_Stability",
  "description": "Monte Carlo stability: centroids, discovery-only detector, dmp_select, mapper, optional biomarker filter, gene_select, stability.",
  "projectPath": "/work/prostate-cancer/configs/project_Healthy_vs_PCa1-5-CG.json",
  "body": [
    {
      "do": "validation.plan_iterations",
      "node_key": "plan_iterations"
    },
    {
      "for": {
        "in": { "ref": "iterations" },
        "as": "iteration",
        "parallel": false
      },
      "do": [
        {
          "for": {
            "in": { "ref": "iteration.centroidGroups" },
            "as": "group",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": { "ref": "project.chromosomes" },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.centroid",
                  "with": {
                    "group": { "ref": "group.label" },
                    "chromosome": { "ref": "chromosome" },
                    "context": { "ref": "context" },
                    "outputDir": { "ref": "group.centroidDir" },
                    "addSamples": { "ref": "group.addSamples" },
                    "removeSamples": { "ref": "group.removeSamples" }
                  },
                  "node_key": "centroid"
                }
              ]
            }
          ]
        },
        {
          "for": {
            "in": { "ref": "project.comparisons" },
            "as": "comparison",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": { "ref": "project.chromosomes" },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.detector",
                  "with": {
                    "chromosome": { "ref": "chromosome" },
                    "context": { "ref": "context" },
                    "comparison": { "ref": "comparison.label" },
                    "stepOverride": {
                      "detection_mode": "discovery_only",
                      "export_classifier": false
                    }
                  },
                  "node_key": "detect"
                },
                {
                  "do": "pipeline.dmp_select",
                  "with": {
                    "chromosome": { "ref": "chromosome" },
                    "context": { "ref": "context" },
                    "comparison": { "ref": "comparison.label" },
                    "group": { "ref": "comparison.label" }
                  },
                  "node_key": "dmp_select"
                }
              ]
            },
            {
              "do": "pipeline.mapper",
              "with": {
                "comparison": { "ref": "comparison.label" },
                "group": { "ref": "comparison.label" }
              },
              "node_key": "mapper"
            },
            {
              "if": {
                "condition": { "ref": "project.stabilityGeneBiomarkerFilterEnabled" }
              },
              "do": {
                "do": "validation.biomarker_filter",
                "with": {
                  "projectPath": { "ref": "iteration.projectPath" },
                  "runDir": { "ref": "iteration.runDir" }
                },
                "node_key": "biomarker_filter"
              }
            },
            {
              "if": {
                "condition": { "ref": "project.stabilityGeneFeaturecutsEnabled" }
              },
              "do": {
                "do": "pipeline.gene_select",
                "with": {
                  "projectPath": { "ref": "iteration.projectPath" },
                  "runDir": { "ref": "iteration.runDir" },
                  "biomarkerFilter": { "ref": "project.stabilityGeneBiomarkerFilterEnabled" }
                },
                "node_key": "gene_select"
              }
            }
          ]
        }
      ]
    },
    {
      "do": "validation.stability",
      "node_key": "stability"
    },
    {
      "do": "validation.stability_freeze_readiness",
      "node_key": "readiness"
    }
  ]
}
