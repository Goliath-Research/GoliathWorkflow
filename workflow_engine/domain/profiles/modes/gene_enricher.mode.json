{
  "dmp_modeling_mode": "raw_pool",
  "gene_modeling_mode": "none",
  "runDmpSelection": false,
  "runGeneFeaturecuts": false,
  "stabilityFeaturecutsEnabled": false,
  "stabilityGeneFeaturecutsEnabled": false,
  "actionConfig": {
    "detection": {
      "detection_mode": "discovery_only",
      "export_classifier": false,
      "dmp_export_mode": "dual"
    },
    "mapper": {
      "csv_pattern": "dmps-*-discovery.csv",
      "enrich_disease": true
    },
    "enricher": {
      "ppi_only": true,
      "network_refinement": {
        "enabled": true,
        "source": "string_api",
        "cache_path": "/work/cache/methylenricher/string_edges",
        "score_threshold": 400.0,
        "community_method": "louvain",
        "min_component_size": 2,
        "weight_in_final_score": 0.3
      }
    },
    "validation": {
      "run_stability": true,
      "dmp_modeling_mode": "raw_pool",
      "gene_modeling_mode": "none",
      "stability_featurecuts_enabled": false,
      "stability_gene_featurecuts_enabled": false,
      "stability_gene_recurrence_source": "enricher",
      "stability_dmp_freq": 0.0,
      "stability_gene_freq": 0.7,
      "stability_early_stop_enabled": false,
      "holdout_eval": false,
      "require_biological_review_for_model": false,
      "biological_review_confirmed": false,
      "regulatory": {
        "stage": "feasibility",
        "intended_use_summary": "Deprecated profile alias mc_gene folded into samd_research mode gene_enricher.",
        "allow_clinical_performance_claims": false,
        "claim_boundary": "Research axis via samd_research mode overlay; not pivotal claims.",
        "primary_analyte": "buffy_coat"
      },
      "validation_partitions": {
        "development_train": [],
        "internal_validation": [],
        "locked_test": [],
        "pivotal_validation": [],
        "post_market_monitoring": [],
        "independence_keys": [
          "sample_id",
          "patient_id",
          "site_id",
          "batch"
        ]
      }
    }
  },
  "researchMode": "gene_enricher"
}
