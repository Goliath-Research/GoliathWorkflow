[Unit]
Description=MethylPipeline workflow worker (%i capability)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Shared non-secret env first; per-VM credentials last.
EnvironmentFile=-/work/epimethyl/env/worker.env
EnvironmentFile=-/work/epimethyl/env/parabricks.env
EnvironmentFile=-/work/epimethyl/env/proteomics.env
EnvironmentFile=-/etc/methyl/worker-token
Environment=WORKER_CAPABILITY=%i
Environment=PATH=__EPIMETHYL_VENV__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__EPIMETHYL_VENV__/bin/methyl-worker --api-base ${WORKER_API_BASE}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
