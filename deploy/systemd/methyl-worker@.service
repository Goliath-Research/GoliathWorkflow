[Unit]
Description=MethylPipeline workflow worker (%i capability)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/work/epimethyl/env/worker.env
EnvironmentFile=-/work/epimethyl/env/parabricks.env
Environment=WORKER_CAPABILITY=%i
# EnvironmentFile does not expand $PATH; set a literal PATH after env files.
# Production: use venv-aarch64 or venv-amd64 per node architecture.
Environment=PATH=/work/epimethyl/venv-aarch64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/work/epimethyl/venv-aarch64/bin/methyl-worker --api-base ${WORKER_API_BASE}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
