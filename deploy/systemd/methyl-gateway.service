[Unit]
Description=MethylPipeline workflow REST gateway (Python)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/work/epimethyl/repos/MethylPipeline
EnvironmentFile=-/work/epimethyl/env/gateway.env
Environment=PATH=/work/epimethyl/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/work/epimethyl/venv/bin/methyl-gateway --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
