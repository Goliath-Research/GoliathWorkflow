[Unit]
Description=MethylPipeline workflow worker (omnibus — all capabilities)
After=network-online.target
Wants=network-online.target
# Optional: Azure Arc agent (when installed via install_arc_agent.sh)
After=azure-arc-agent.service
Wants=azure-arc-agent.service

[Service]
Type=simple
EnvironmentFile=-/etc/methyl/worker-token
EnvironmentFile=-/work/epimethyl/env/worker.env
EnvironmentFile=-/work/epimethyl/env/parabricks.env
# EnvironmentFile does not expand $PATH; set a literal PATH after env files.
Environment=PATH=__EPIMETHYL_VENV__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__EPIMETHYL_VENV__/bin/methyl-worker --api-base ${WORKER_API_BASE}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
