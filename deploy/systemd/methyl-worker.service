[Unit]
Description=MethylPipeline workflow worker (omnibus — all capabilities)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/work/epimethyl/env/worker.env
EnvironmentFile=-/work/epimethyl/env/parabricks.env
# EnvironmentFile does not expand $PATH; set a literal PATH after env files.
Environment=PATH=/work/epimethyl/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/work/epimethyl/venv/bin/methyl-worker --api-base ${WORKER_API_BASE}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
