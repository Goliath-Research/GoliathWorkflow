# MethylPipeline Production Container
FROM nvidia/cuda:13.0.0-devel-ubuntu22.04

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    hdf5-tools \
    libhdf5-dev \
    libzstd-dev \
    curl \
    gnupg \
    apt-transport-https \
    unixodbc-dev \
    bzip2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Microsoft ODBC Driver 18 for SQL Server
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/ubuntu/22.04/prod jammy main" > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && \
    ACCEPT_EULA=Y apt-get install -y msodbcsql18 && \
    rm -rf /var/lib/apt/lists/*

# Create ubuntu user and set up permissions
RUN groupadd -r ubuntu && useradd -r -g ubuntu -d /home/ubuntu -s /bin/bash ubuntu
RUN mkdir -p /home/ubuntu && chown -R ubuntu:ubuntu /home/ubuntu
RUN usermod -aG sudo ubuntu
RUN echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Install Miniforge (conda) and RAPIDS nightly for CUDA 13.0
ENV CONDA_DIR=/opt/conda
RUN curl -fsSL https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -o /tmp/miniforge.sh && \
    bash /tmp/miniforge.sh -b -p $CONDA_DIR && \
    rm /tmp/miniforge.sh
ENV PATH="${CONDA_DIR}/bin:${PATH}"

RUN conda install -y -n base -c conda-forge mamba && \
    mamba create -y -n rapids-25.10 -c rapidsai-nightly -c conda-forge -c nvidia \
        rapids=25.10 python=3.12 'cuda-version=13.0' \
        jupyter hdbscan umap-learn && \
    mamba install -y -n rapids-25.10 -c conda-forge \
        h5py hdf5plugin zarr pyarrow psutil plotly matplotlib seaborn \
        click tqdm statsmodels sqlalchemy scikit-learn pydantic pyodbc pymssql && \
    conda clean -ay

ENV CONDA_DEFAULT_ENV=rapids-25.10
ENV PATH="/opt/conda/envs/rapids-25.10/bin:/opt/conda/bin:${PATH}"

# Install Python utilities not provided by conda
RUN pip install --no-cache-dir --retries 3 nvidia-ml-py rich sqlmodel

# Copy all packages to container
COPY ../packages /tmp/methylpipeline-packages

# Install all packages in production mode (non-editable)
RUN cd /tmp/methylpipeline-packages/methylutils && pip install . --no-deps && \
    cd /tmp/methylpipeline-packages/methylcentroid && pip install . --no-deps && \
    cd /tmp/methylpipeline-packages/methylcluster && pip install . --no-deps && \
    cd /tmp/methylpipeline-packages/methylmodeler && pip install . --no-deps && \
    cd /tmp/methylpipeline-packages/methylmapper && pip install . --no-deps && \
    cd /tmp/methylpipeline-packages/methylclassifier && pip install . --no-deps && \
    cd /tmp/methylpipeline-packages/methylenricher && pip install . --no-deps && \
    rm -rf /tmp/methylpipeline-packages

# Create CuPy cache directory with proper permissions
RUN mkdir -p /home/ubuntu/.cupy && \
    chown -R ubuntu:ubuntu /home/ubuntu/.cupy && \
    chmod 755 /home/ubuntu/.cupy

# Set environment variables for optimization
ENV CUDA_VISIBLE_DEVICES=0 \
    OMP_NUM_THREADS=8 \
    MKL_NUM_THREADS=8 \
    NUMEXPR_NUM_THREADS=8 \
    PYTHONUNBUFFERED=1 \
    HDF5_USE_FILE_LOCKING=FALSE \
    PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512 \
    CUPY_CACHE_DIR=/home/ubuntu/.cupy/kernel_cache

# Health check - basic Python/CUDA check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import cupy; print('CUDA container ready')"

# Switch to ubuntu user
USER ubuntu
WORKDIR /home/ubuntu

# Default command
CMD ["python3", "-c", "print('MethylPipeline Production Container Ready')"]
