# MethylPipeline Production Container
FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    build-essential \
    git \
    hdf5-tools \
    libhdf5-dev \
    libzstd-dev \
    curl \
    gnupg \
    apt-transport-https \
    unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Microsoft ODBC Driver 18 for SQL Server
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/ubuntu/22.04/prod jammy main" > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && \
    ACCEPT_EULA=Y apt-get install -y msodbcsql18 && \
    rm -rf /var/lib/apt/lists/*

# Create ubuntu user and set up permissions
RUN groupadd -r ubuntu && useradd -r -g ubuntu -d /home/ubuntu -s /bin/bash ubuntu
RUN mkdir -p /home/ubuntu && chown -R ubuntu:ubuntu /home/ubuntu
RUN usermod -aG sudo ubuntu
RUN echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Create Python virtual environment for production
RUN python3.10 -m venv /opt/methylpipeline
ENV PATH="/opt/methylpipeline/bin:$PATH"

# Make sure ubuntu user can access the virtual environment
RUN chown -R ubuntu:ubuntu /opt/methylpipeline

# Install Python packages with CUDA support
RUN pip install --upgrade pip setuptools wheel

# Install CuPy with CUDA 12.x support
RUN pip install cupy-cuda12x

# Install scientific computing libraries
RUN pip install \
    numpy \
    scipy \
    pandas \
    h5py \
    hdf5plugin \
    nvidia-ml-py>=12.535.0 \
    psutil \
    plotly \
    matplotlib \
    seaborn \
    pydantic \
    click \
    zarr \
    tqdm \
    statsmodels \
    sqlalchemy

# Install SQL drivers (pyodbc for ODBC, pymssql as fallback for ARM64)
RUN pip install pyodbc || echo "pyodbc installation failed" && \
    pip install pymssql

# Install RAPIDS for GPU data frames (before numba to avoid conflicts)
RUN pip install cudf-cu12 --no-cache-dir

# Install numba after RAPIDS to avoid version conflicts
RUN pip install numba

# Copy all packages to container
COPY ../packages /tmp/methylpipeline-packages

# Install all packages in production mode (non-editable)
RUN cd /tmp/methylpipeline-packages/methylutils && pip install . && \
    cd /tmp/methylpipeline-packages/methylcentroid && pip install . && \
    cd /tmp/methylpipeline-packages/methyldetector && pip install . && \
    cd /tmp/methylpipeline-packages/methylmapper && pip install . && \
    cd /tmp/methylpipeline-packages/methyltrainer && pip install . && \
    cd /tmp/methylpipeline-packages/methylclassifier && pip install . && \
    cd /tmp/methylpipeline-packages/methylenricher && pip install . && \
    rm -rf /tmp/methylpipeline-packages

# Create CuPy cache directory with proper permissions
RUN mkdir -p /home/ubuntu/.cupy && \
    chown -R ubuntu:ubuntu /home/ubuntu/.cupy && \
    chmod 755 /home/ubuntu/.cupy

# Set environment variables for optimization
ENV CUDA_VISIBLE_DEVICES=0 \
    OMP_NUM_THREADS=8 \
    MKL_NUM_THREADS=8 \
    NUMEXPR_NUM_THREADS=8 \
    PYTHONUNBUFFERED=1 \
    HDF5_USE_FILE_LOCKING=FALSE \
    PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512 \
    CUPY_CACHE_DIR=/home/ubuntu/.cupy/kernel_cache

# Health check - basic Python/CUDA check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import cupy; print('CUDA container ready')"

# Switch to ubuntu user
USER ubuntu
WORKDIR /home/ubuntu

# Default command
CMD ["python3", "-c", "print('MethylPipeline Production Container Ready')"]
